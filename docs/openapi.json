 "components": {
  "schemas": {
   "Citation": {
    "properties": {
     "document_id": {
      "type": "string",
      "title": "Document Id"
     },
     "document_title": {
      "type": "string",
      "title": "Document Title"
     },
     "document_date": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Document Date"
     },
     "passage_id": {
      "type": "string",
      "title": "Passage Id"
     },
     "quote": {
      "type": "string",
      "title": "Quote",
      "description": "Exact source text of the cited span (readable form)"
     },
     "passage_text": {
      "type": "string",
      "title": "Passage Text",
      "description": "The full sentence/table row that contains the span"
     },
     "original_start": {
      "type": "integer",
      "title": "Original Start"
     },
     "original_end": {
      "type": "integer",
      "title": "Original End"
     },
     "source_id": {
      "type": "string",
      "title": "Source Id",
      "description": "Exact document version (source) the offsets refer to",
      "default": ""
     },
     "source_sha256": {
      "type": "string",
      "title": "Source Sha256",
      "description": "SHA-256 of the original source text of that version",
      "default": ""
     },
     "verified": {
      "type": "boolean",
      "title": "Verified",
      "description": "Citation integrity only: offsets, passage, quote, checksum, patient, current version. Says nothing about whether the claim is correct.",
      "default": false
     },
     "integrity_errors": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Integrity Errors",
      "default": []
     }
    },
    "type": "object",
    "required": [
     "document_id",
     "document_title",
     "document_date",
     "passage_id",
     "quote",
     "passage_text",
     "original_start",
     "original_end"
    ],
    "title": "Citation"
   },
