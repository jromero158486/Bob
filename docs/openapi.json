     "conflict_ids": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Conflict Ids",
      "default": []
     },
     "review_status": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Review Status"
     },
     "notes": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Notes",
      "default": []
     },
