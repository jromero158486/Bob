APP_ENV=development
DATA_DIR=./data/patient-0000-0001
DATABASE_URL=sqlite:///./artifacts/clinical.db

# LLM (optional). none | openai | ollama. Keys are read from the environment only; never commit them.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# GERNERMED++ (optional, isolated interpreter with spaCy 3.2.3 + model wheel; see docs/LAYER2_EXTRACTION.md)
GERNERMED_PYTHON=
GERNERMED_MODEL=de_GERNERMEDpp_GottBERT

# Private test data for the optional integration test (never commit the data)
CLINICAL_IBM_DATA=

# Groq (OpenAI-compatible): OPENAI_BASE_URL=https://api.groq.com/openai/v1 OPENAI_MODEL=openai/gpt-oss-120b
